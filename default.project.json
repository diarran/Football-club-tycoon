    "$className": "DataModel",
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "Ambient": [
          0.35,
          0.35,
          0.38
        ],
        "OutdoorAmbient": [
          0.55,
          0.55,
          0.58
        ],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.25,
          "Offset": 0.1,
          "Haze": 1
